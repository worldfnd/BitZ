%%% claimledger.sty ---------------------------------------------------------
%%
%%  A margin-resident ledger of OPEN CLAIMS for step-by-step protocol notes.
%%
%%  The document maintains a live set of claims that still have to be
%%  discharged.  Every protocol step declares how it mutates that set, and the
%%  package renders the resulting set into the margin, colour-coding the rows
%%  the step touched.  Because the ledger is derived rather than transcribed,
%%  it cannot drift out of sync with the narrative.
%%
%%  Authoring interface
%%  -------------------
%%    \clgnew  {id}{body}   open a new claim
%%    \clgupd  {id}{body}   rewrite an existing claim (it was reduced, not closed)
%%    \clgtouch{id}         mark a claim as used/inspected, body unchanged
%%    \clgdone {id}         discharge a claim (shown struck out once, then dropped)
%%    \clgnote {id}{text}   attach a one-line annotation to a claim's next render
%%    \clgdef  {id}{text}   PIN a definition under the claims (not a claim: no
%%                          status, never discharged, shown on every board)
%%    \clgundef{id}         unpin a definition
%%
%%    \begin{step}{Title}{ledger ops}  ... prose ...  \end{step}
%%    \clgboard                        render the board by hand
%%    \clgreset                        empty the ledger (start of a new walkthrough)
%%
%%  Status colours:  new = created here, reduced = rewritten here (\clgupd),
%%                   used = read but unchanged (\clgtouch), discharged = closed
%%                   here, carried = the step said nothing about it.
%%
%% -------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{claimledger}[2026/07/24 v1.0 margin ledger of open claims]

\RequirePackage{expl3}
\RequirePackage{xparse}
\RequirePackage{xcolor}
\RequirePackage[normalem]{ulem}

%% ---- palette -------------------------------------------------------------
\definecolor{clgnewc}    {HTML}{1B7F3B}  % green   -- opened here
\definecolor{clgtouchc}  {HTML}{B25F00}  % amber   -- reduced here
\definecolor{clgdonec}   {HTML}{A81E1E}  % red     -- discharged here
\definecolor{clgcarryc}  {HTML}{6B7280}  % grey    -- carried, untouched
\definecolor{clgframec}  {HTML}{D8DCE3}
\definecolor{clgtitlec}  {HTML}{374151}
\definecolor{clgbgc}     {HTML}{FBFBFD}

%% ---- board title (redefine to taste) -------------------------------------
\newcommand{\clgboardtitle}{Open claims}

%% ---- strike-through that survives line breaks ----------------------------
\newcommand{\clgstrike}[1]{\textcolor{clgcarryc}{\sout{#1}}}

\ExplSyntaxOn

%% ---- state ---------------------------------------------------------------
\seq_new:N  \g__clg_open_seq     % ordered claim ids currently open
\prop_new:N \g__clg_body_prop    % id -> body (math)
\prop_new:N \g__clg_stat_prop    % id -> status for the step being rendered
\prop_new:N \g__clg_note_prop    % id -> one-shot annotation
\seq_new:N  \g__clg_kill_seq     % ids to drop once the board has been drawn
\seq_new:N  \g__clg_def_seq      % ordered ids of PINNED DEFINITIONS
\prop_new:N \g__clg_defbody_prop % def id -> body

\tl_new:N \l__clg_stat_tl
\tl_new:N \l__clg_body_tl
\tl_new:N \l__clg_note_tl
\tl_new:N \l__clg_id_tl
\tl_new:N \l__clg_col_tl
\tl_new:N \l__clg_lab_tl
\bool_new:N \l__clg_dead_bool

%% ---- mutation API --------------------------------------------------------
\NewDocumentCommand \clgnew { m m }
  {
    \seq_if_in:NnF \g__clg_open_seq {#1}
      { \seq_gput_right:Nn \g__clg_open_seq {#1} }
    \prop_gput:Nnn \g__clg_body_prop {#1} {#2}
    \prop_gput:Nnn \g__clg_stat_prop {#1} {new}
  }

\NewDocumentCommand \clgupd { m m }
  {
    \seq_if_in:NnF \g__clg_open_seq {#1}
      { \seq_gput_right:Nn \g__clg_open_seq {#1} }
    \prop_gput:Nnn \g__clg_body_prop {#1} {#2}
    \prop_gput:Nnn \g__clg_stat_prop {#1} {touch}
  }

\NewDocumentCommand \clgtouch { m }
  { \prop_gput:Nnn \g__clg_stat_prop {#1} {used} }

\NewDocumentCommand \clgdone { m }
  {
    \prop_gput:Nnn \g__clg_stat_prop {#1} {done}
    \seq_gput_right:Nn \g__clg_kill_seq {#1}
  }

%% Pinned definitions. These are NOT claims -- they carry no status, are never
%% discharged, and render in their own block below the claim list. They exist so
%% a reader meeting `P` in a claim body four steps later still knows what it is.
\NewDocumentCommand \clgdef { m m }
  {
    \seq_if_in:NnF \g__clg_def_seq {#1}
      { \seq_gput_right:Nn \g__clg_def_seq {#1} }
    \prop_gput:Nnn \g__clg_defbody_prop {#1} {#2}
  }

\NewDocumentCommand \clgundef { m }
  {
    \seq_gremove_all:Nn \g__clg_def_seq {#1}
    \prop_gremove:Nn \g__clg_defbody_prop {#1}
  }

\NewDocumentCommand \clgnote { m m }
  { \prop_gput:Nnn \g__clg_note_prop {#1} {#2} }

\NewDocumentCommand \clgreset { }
  {
    \seq_gclear:N \g__clg_open_seq
    \prop_gclear:N \g__clg_body_prop
    \prop_gclear:N \g__clg_stat_prop
    \prop_gclear:N \g__clg_note_prop
    \seq_gclear:N \g__clg_kill_seq
    \seq_gclear:N \g__clg_def_seq
    \prop_gclear:N \g__clg_defbody_prop
  }

%% ---- one ledger row ------------------------------------------------------
%% Reads \l__clg_id_tl, \l__clg_body_tl, \l__clg_note_tl, \l__clg_col_tl,
%% \l__clg_lab_tl and \l__clg_dead_bool.
\cs_new_protected:Npn \__clg_row_out:
  {
    \par \addvspace { 0.55 em }
    \begingroup
      \leftskip = 1.05 em
      \parindent = 0 pt
      \noindent
      \llap
        {
          \textcolor { \tl_use:N \l__clg_col_tl }
            { \rule [ -0.15 ex ] { 1.6 pt } { 1.55 ex } }
          \hspace { 0.55 em }
        }
      { \scriptsize
        \textcolor { \tl_use:N \l__clg_col_tl }
          { \bfseries \boldmath \tl_use:N \l__clg_id_tl }
        \tl_if_empty:NF \l__clg_lab_tl
          {
            \hspace { 0.35 em }
            \textcolor { \tl_use:N \l__clg_col_tl }
              { \fontsize {5.4} {6} \selectfont \textsc { \tl_use:N \l__clg_lab_tl } }
          }
        \par \nobreak \vspace { 0.12 em }
        %% Bodies run a little smaller than the id badge: the panel is narrow,
        %% and a struck-out body is a single unbreakable box (ulem cannot break
        %% inside math), so it must fit on one line.
        \fontsize {7} {8.2} \selectfont
        \bool_if:NTF \l__clg_dead_bool
          { \clgstrike { \tl_use:N \l__clg_body_tl } }
          { \tl_use:N \l__clg_body_tl }
        \tl_if_empty:NF \l__clg_note_tl
          {
            \par \nobreak \vspace { 0.1 em }
            \textcolor { clgcarryc }
              { \fontsize {5.6} {6.6} \selectfont \itshape \tl_use:N \l__clg_note_tl }
          }
        \par
      }
    \endgroup
  }

%% ---- render the whole board ---------------------------------------------
\cs_new_protected:Npn \__clg_render:
  {
    \seq_if_empty:NTF \g__clg_open_seq
      {
        { \scriptsize \itshape \textcolor { clgnewc } { nothing~left~to~prove } \par }
      }
      {
        \seq_map_inline:Nn \g__clg_open_seq
          {
            \tl_set:Nn \l__clg_id_tl {##1}
            \prop_get:NnNF \g__clg_stat_prop {##1} \l__clg_stat_tl
              { \tl_set:Nn \l__clg_stat_tl { carry } }
            \prop_get:NnNF \g__clg_body_prop {##1} \l__clg_body_tl
              { \tl_clear:N \l__clg_body_tl }
            \prop_get:NnNF \g__clg_note_prop {##1} \l__clg_note_tl
              { \tl_clear:N \l__clg_note_tl }
            \bool_set_false:N \l__clg_dead_bool
            \str_case:VnF \l__clg_stat_tl
              {
                { new }
                  {
                    \tl_set:Nn \l__clg_col_tl { clgnewc }
                    \tl_set:Nn \l__clg_lab_tl { new }
                  }
                { touch }
                  {
                    \tl_set:Nn \l__clg_col_tl { clgtouchc }
                    \tl_set:Nn \l__clg_lab_tl { reduced }
                  }
                { used }
                  {
                    \tl_set:Nn \l__clg_col_tl { clgtouchc }
                    \tl_set:Nn \l__clg_lab_tl { used }
                  }
                { done }
                  {
                    \tl_set:Nn \l__clg_col_tl { clgdonec }
                    \tl_set:Nn \l__clg_lab_tl { discharged }
                    \bool_set_true:N \l__clg_dead_bool
                  }
              }
              {
                \tl_set:Nn \l__clg_col_tl { clgcarryc }
                \tl_clear:N \l__clg_lab_tl
              }
            \__clg_row_out:
          }
      }
  }

%% ---- the pinned-definition block ----------------------------------------
\tl_new:N \l__clg_defid_tl
\tl_new:N \l__clg_defbody_tl

\cs_new_protected:Npn \__clg_render_defs:
  {
    \seq_if_empty:NF \g__clg_def_seq
      {
        \par \addvspace { 0.6 em }
        \textcolor { clgframec } { \rule { \linewidth } { 0.4 pt } }
        \par \nobreak \vspace { 0.2 em }
        { \fontsize {5.6} {6.6} \selectfont \bfseries \sffamily
          \textcolor { clgcarryc } { WHERE } }
        \seq_map_inline:Nn \g__clg_def_seq
          {
            \tl_set:Nn \l__clg_defid_tl {##1}
            \prop_get:NnNF \g__clg_defbody_prop {##1} \l__clg_defbody_tl
              { \tl_clear:N \l__clg_defbody_tl }
            \par \nobreak \addvspace { 0.3 em }
            \begingroup
              \leftskip = 1.05 em
              \parindent = 0 pt
              \noindent
              \llap { \textcolor { clgcarryc } { \bfseries \boldmath
                      \fontsize {6.6} {7.6} \selectfont
                      \tl_use:N \l__clg_defid_tl } \hspace { 0.55 em } }
              { \fontsize {6.2} {7.2} \selectfont
                \textcolor { clgcarryc } { \tl_use:N \l__clg_defbody_tl } \par }
            \endgroup
          }
      }
  }

%% ---- drop discharged claims, clear per-step marks ------------------------
\cs_new_protected:Npn \__clg_flush:
  {
    \seq_map_inline:Nn \g__clg_kill_seq
      {
        \seq_gremove_all:Nn \g__clg_open_seq {##1}
        \prop_gremove:Nn \g__clg_body_prop {##1}
      }
    \seq_gclear:N \g__clg_kill_seq
    \prop_gclear:N \g__clg_stat_prop
    \prop_gclear:N \g__clg_note_prop
  }

%% ---- the public board command -------------------------------------------
%%
%% The board is typeset into a save box first, so that its height is known
%% before placement.  It is then dropped into the margin with an explicit
%% zero-width, zero-height \makebox -- deterministic positioning that does not
%% depend on \marginpar's float machinery.  \g_clg_boardht_dim records the
%% height so that the enclosing step can reserve room and stop consecutive
%% boards from colliding.
%%
\box_new:N   \g__clg_board_box
\dim_new:N   \g_clg_boardht_dim
\dim_new:N   \g_clg_stepstart_dim
\bool_new:N  \g_clg_instep_bool

\cs_new_protected:Npn \__clg_build_box:
  {
    \hbox_gset:Nn \g__clg_board_box
      {
        \dim_set:Nn \fboxsep { 0.5 em }
        \parbox [t] { \marginparwidth }
          {
            \dim_zero:N \parskip
            \dim_zero:N \parindent
            \raggedright
            \hbadness = 10000
            \emergencystretch = 2 em
            \colorbox { clgbgc }
              {
                \begin { minipage } { \dimexpr \marginparwidth - 2\fboxsep \relax }
                  \dim_zero:N \parindent
                  \raggedright
                  { \fontsize {6.4} {7.6} \selectfont \bfseries \sffamily
                    \textcolor { clgtitlec }
                      { \MakeUppercase { \clgboardtitle } } }
                  \par \vspace { 0.15 em }
                  \textcolor { clgframec } { \rule { \linewidth } { 0.6 pt } }
                  \__clg_render:
                  \__clg_render_defs:
                  \vspace { 0.25 em }
                \end { minipage }
              }
          }
      }
    \dim_gset:Nn \g_clg_boardht_dim
      { \box_ht:N \g__clg_board_box + \box_dp:N \g__clg_board_box }
  }

%% \clgboard [vertical nudge]
\NewDocumentCommand \clgboard { O{0pt} }
  {
    \__clg_build_box:
    \par
    \nointerlineskip
    \noindent
    \hbox_to_zero:n
      {
        \skip_horizontal:n { \textwidth + \marginparsep }
        \raisebox { -#1 } [ \c_zero_dim ] [ \c_zero_dim ]
          { \box_use:N \g__clg_board_box }
        \hss
      }
    \par
    \nointerlineskip
    \__clg_flush:
  }

%% Reserve enough vertical space that the next board cannot ride up into this
%% one.  \pagetotal is only meaningful in vertical mode, hence the \par above
%% and the guard against a page break having intervened.
\NewDocumentCommand \clgreserve { }
  {
    \par
    \bool_if:NT \g_clg_instep_bool
      {
        \dim_set:Nn \l_tmpa_dim { \pagetotal - \g_clg_stepstart_dim }
        \dim_compare:nNnT { \l_tmpa_dim } > { \c_zero_dim }
          {
            \dim_compare:nNnT { \l_tmpa_dim } < { \g_clg_boardht_dim }
              {
                \vspace* { \dimexpr \g_clg_boardht_dim - \l_tmpa_dim \relax }
              }
          }
        \bool_gset_false:N \g_clg_instep_bool
      }
  }

\NewDocumentCommand \clgmarkstart { }
  {
    \par
    \dim_gset:Nn \g_clg_stepstart_dim { \pagetotal }
    \bool_gset_true:N \g_clg_instep_bool
  }

\ExplSyntaxOff

%% ---- the step environment ------------------------------------------------
%% #1 = title, #2 = ledger mutations applied before the board is drawn.
\newcounter{clgstep}
\renewcommand{\theclgstep}{\arabic{clgstep}}

\newenvironment{step}[2]
  {%
    \par\addvspace{1.1\baselineskip}%
    \refstepcounter{clgstep}%
    \clgmarkstart
    \noindent
    {\normalsize\bfseries\sffamily
     \textcolor{clgtitlec}{Step \theclgstep.}~#1}%
    \nopagebreak\par\vspace{0.25\baselineskip}%
    #2%
    \clgboard
    \nopagebreak
  }
  {\clgreserve\par\addvspace{0.5\baselineskip}}

%% A step that carries no number (used for framing / recap interludes).
\newenvironment{step*}[2]
  {%
    \par\addvspace{1.1\baselineskip}%
    \clgmarkstart
    \noindent
    {\normalsize\bfseries\sffamily\textcolor{clgtitlec}{#1}}%
    \nopagebreak\par\vspace{0.25\baselineskip}%
    #2%
    \clgboard
    \nopagebreak
  }
  {\clgreserve\par\addvspace{0.5\baselineskip}}

\endinput
