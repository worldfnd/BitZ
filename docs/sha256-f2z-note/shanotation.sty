%%% shanotation.sty ----------------------------------------------------------
%%
%%  Notation for the SHA-256 / F2Z construction note.
%%
%%  Two witness symbols carry the whole document and are kept visually distinct:
%%    \ff  the COMMITTED witness      (bits, behind the Merkle root)
%%    \hh  the VIRTUAL witness         (bits, never committed, h = pi_2^{-1}(M pi_2 f))
%%  Public SHA data parameterises A; it is not a third PIOP witness block.
%%
%% -------------------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{shanotation}[2026/08/08 v1.0 SHA-256 F2Z notation]

\RequirePackage{amsmath,amssymb,bm}
\RequirePackage{mathtools}
\RequirePackage{bbm}
\RequirePackage{xcolor}

%% ---- domains -------------------------------------------------------------
\newcommand{\F}{\mathbb{F}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\K}{\mathbb{K}}                  % evaluation field, char q
\newcommand{\Ftwo}{\F_2}
\newcommand{\Fq}{\F_q}
\newcommand{\comfield}{\F_{2^{128}}}          % commitment field (GHASH)
\newcommand{\bits}{\{0,1\}}
\newcommand{\rge}[2]{[#1 \,..\, #2]}
\newcommand{\bitpoly}{\bits^{<32}[X]}

%% ---- witness vectors and public parameters -------------------------------
\newcommand{\ff}{\mathbf{f}}                 % committed witness
\newcommand{\hh}{\mathbf{h}}                 % virtual witness
\newcommand{\xx}{\mathbf{x}}                 % public input
\newcommand{\orc}{\mathsf{o}}                % the oracle / codeword

%% ---- matrix axes ---------------------------------------------------------
%% Reader-facing names.  The implementation aliases these dimensions to
%% ell_1/ell_2 and t_w/s; the protocol body uses row/col throughout.
\newcommand{\Rows}{\mathsf{Rows}}
\newcommand{\Cols}{\mathsf{Cols}}
\newcommand{\rowidx}{\mathsf{row}}
\newcommand{\colidx}{\mathsf{col}}
\newcommand{\rowprefix}{\mathsf{rowPrefix}}
\newcommand{\ellrow}{\ell_{\mathrm{row}}}
\newcommand{\ellcol}{\ell_{\mathrm{col}}}
\newcommand{\drow}{d_{\mathrm{row}}}
\newcommand{\dcol}{d_{\mathrm{col}}}
\newcommand{\zrow}{z_{\mathrm{row}}}
\newcommand{\zcol}{z_{\mathrm{col}}}

%% ---- maps ----------------------------------------------------------------
%% \psitwo (psi_2 : Z[X] -> Z, a(X) |-> a(2)) was defined here and never used.
%% Removed: it belongs to the polynomial-witness design this note rejects, and
%% having two unrelated psis in scope is what made \psi read as undefined.
\newcommand{\pitwo}{\pi_2}                   % Z -> F_2
\newcommand{\bitsop}{\mathsf{bits}}
\newcommand{\pack}{\mathsf{Pack}_{128}}
\newcommand{\Enc}{\mathsf{Enc}}
\newcommand{\eq}{\mathsf{eq}}
\newcommand{\mle}[1]{\widetilde{#1}}
%% ---- inner products: ALWAYS field-annotated ------------------------------
%% The protocol changes ring three times and the same bracket means three
%% different things at three points.  Every inner product carries its field.
%%
%%   \ipq   over K = \Fq          the zero-check; ODD characteristic
%%   \ipZ   over \Z               after the tensor split sends mu[col] as integers
%%   \ipC   over \comfield        from the exponent fold onward; characteristic 2
%%
%% This is not decoration.  The adjoint identity
%%     <v, pi_2(h)> = <M^T v, pi_2(f)>
%% is an identity in \ipC and is FALSE in \ipq and in \ipZ -- with
%% M' = [[1,0],[0,1],[1,1]], v = (0,0,1), f = (1,1) the two sides are 0 and 2.
%% Making that visible at a glance is the entire reason these exist.
%%
%% \ip is retained only for genuinely ring-free statements; prefer the
%% annotated forms everywhere a protocol position fixes the ambient ring.
\newcommand{\ip}[2]{\langle #1,\, #2\rangle}
\newcommand{\ipq}[2]{\langle #1,\, #2\rangle_{\Fq}}
\newcommand{\ipZ}[2]{\langle #1,\, #2\rangle_{\Z}}
\newcommand{\ipC}[2]{\langle #1,\, #2\rangle_{\comfield}}
\newcommand{\defeq}{\vcentcolon=}
\newcommand{\gen}{g}
\newcommand{\ord}{\mathrm{ord}}
\newcommand{\gam}{\bm{\gamma}}
\newcommand{\cC}{\mathcal{C}}

%% ---- public coefficient vectors ------------------------------------------
%% v : the row-collapsed coefficient vector A^T eq(.,r), reshaped in Section 4
\newcommand{\ww}{\mathbf{w}}
\newcommand{\vv}{\mathbf{v}}
\newcommand{\uu}{\mathbf{u}}

%% Compact name for the commit pipeline; pinned to every ledger board.
\newcommand{\cw}[1]{\mathsf{cw}(#1)}

%% ---- SHA-256 ------------------------------------------------------------
\newcommand{\off}{\mathit{off}}
\newcommand{\ROTR}{\mathsf{ROTR}}
\newcommand{\ROTL}{\mathsf{ROTL}}
\newcommand{\SHR}{\mathsf{SHR}}
\newcommand{\Ch}{\mathsf{Ch}}
\newcommand{\Maj}{\mathsf{Maj}}
\newcommand{\xor}{\mathbin{\mathsf{XOR}}}
\newcommand{\andop}{\mathbin{\mathsf{AND}}}
\newcommand{\notop}{\mathsf{\neg}}
%% compact XOR for tables and inline prose, where the word form is too wide
\newcommand{\xo}{\oplus}

%% ---- relations -----------------------------------------------------------
\newcommand{\Rel}{\mathcal{R}}
\newcommand{\RLBD}{\Rel_{\mathsf{Lin\text{-}BitsDual}}}
\newcommand{\RLMFB}{\Rel_{\mathsf{Lin\text{-}ModFieldBin}}}
\newcommand{\RLin}{\Rel_{\mathsf{Lin}}}
\newcommand{\Rvirt}{\Rel^{\mathsf{lin\text{-}virtual}}}

%% ---- editorial -----------------------------------------------------------
\definecolor{srcgrey}{HTML}{5B6472}
\newcommand{\code}[1]{{\def\_{\textunderscore\allowbreak}\texttt{#1}}}
\newcommand{\src}[1]{{\footnotesize\textcolor{srcgrey}{\code{#1}}}}

\endinput
